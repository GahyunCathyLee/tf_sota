__pycache__/
*.pyc
external/*
!external/.gitkeep
runs/*
!runs/.gitkeep

# Sweep outputs (configs/mtp_go/_base.yaml writes here)
ckpts/
tensorboard/

# Datasets: version the preprocessing/split scripts, never the arrays.
# Directories must stay un-excluded for the negations below to apply.
data/**
!data/**/
!data/**/*.py
!data/**/*.md
!data/.gitkeep
